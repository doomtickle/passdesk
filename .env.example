# Endpoint the waitlist form POSTs to (FormData with email, company, source).
# Any endpoint that accepts a form POST and returns a 2xx status works, e.g. Formspree:
# VITE_WAITLIST_ENDPOINT=https://formspree.io/f/your-form-id
VITE_WAITLIST_ENDPOINT=

# Cloudflare Web Analytics beacon token (cookieless, page views only, no
# custom events). Public, not a secret: it ships in the page's HTML anyway.
# Create a site at https://dash.cloudflare.com -> Analytics -> Web Analytics
# to get one; it's a 32-character hex string. Optional: when unset, the
# build prints a warning but still succeeds, and no beacon script ships.
# VITE_CF_ANALYTICS_TOKEN=
