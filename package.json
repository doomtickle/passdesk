{
  "name": "passdesk-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:preview": "tsc --noEmit && PASSDESK_ALLOW_UNCONFIGURED=1 vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \".test-dist/*.test.js\"",
    "og": "node scripts/og.mjs"
  },
  "dependencies": {
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@fontsource/schibsted-grotesk": "5.3.0",
    "@resvg/resvg-wasm": "2.6.2",
    "@types/markdown-it": "14.2.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "markdown-it": "14.3.3",
    "typescript": "~5.6.3",
    "vite": "^5.4.10"
  }
}
